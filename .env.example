# =============================================================================
# Convex (required for jobs, templates, assignment, search)
# =============================================================================
# Local: after `npm run convex:login` + `npm run convex:dev`, Convex writes
# `VITE_CONVEX_URL` into `.env.local`, or use `enableConvexDevelopmentDeployment()`
# in App.vue (dev) which sets a fixed development deployment URL in code.
#
# Production / Vercel: set `VITE_CONVEX_URL` to your deployment URL, and prefer
# `npx convex deploy --cmd "npm run build" --cmd-url-env-var-name VITE_CONVEX_URL`
# so the URL matches the deployed functions.
#
# VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
#
# =============================================================================
# AI agent (Convex backend only — do NOT use VITE_ prefix)
# =============================================================================
# Set these in the Convex Dashboard → Settings → Environment Variables
# (or `npx convex env set NAME value`). They are read by Convex actions, not
# by the Vite client.
#
# GEMINI_API_KEY=        # Google AI Studio key for Gemini (agent chat)
# VOYAGE_API_KEY=        # Voyage AI key for embeddings / vector search
# VOYAGE_DISABLED=1      # Set to skip all Voyage calls (no billing / errors) until you enable billing
# GEMINI_MODEL=          # Optional override (default: gemini-2.5-flash, falls back to gemini-2.0-flash)
#
